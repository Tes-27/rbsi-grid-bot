# คัดลอกเป็น .env แล้ว chmod 600 .env
# Deribit: สร้าง key ใน subaccount ที่จะให้บอทเทรด สิทธิ์ trade:read_write (ไม่ต้องมี wallet/withdraw) + ล็อก IP ถ้าทำได้
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
# Telegram: คุยกับ @BotFather สร้างบอท → token · ทักบอทหนึ่งครั้งแล้วเปิด https://api.telegram.org/bot<TOKEN>/getUpdates หา chat id
TG_BOT_TOKEN=
TG_CHAT_ID=
